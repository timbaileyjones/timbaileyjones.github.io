<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
  <meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.tagline }}{% endif %}">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <nav>
      <div class="nav-container">
        <a href="/" class="site-title">Tim <span>Bailey Jones</span></a>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/ensembles">Ensembles</a></li>
          <li><a href="/albums">Albums</a></li>
          <li><a href="/performances">Performances</a></li>
          {# <li><a href="/equipment">Equipment</a></li> #}
        </ul>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
          <span id="theme-toggle-text">Dark</span>
        </button>
      </div>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <div class="footer-container">
      <p>&copy; {% year %} Tim Bailey Jones. Music is my hobby.</p>
      <p class="footer-note">Professional consulting: <a href="https://linuxtampa.com" target="_blank" rel="noopener">LinuxTampa.com</a></p>
    </div>
  </footer>
  <script src="/js/theme-toggle.js"></script>
  <script src="/js/ensemble-carousel.js"></script>
  <script src="/js/album-carousel.js"></script>
</body>
</html>
